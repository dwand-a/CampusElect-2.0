rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user exists in voters collection (our current structure)
    function voterExists() {
      return exists(/databases/$(database)/documents/voters/$(request.auth.uid));
    }
    
    // Helper function to check if user exists in users collection (alternative structure)
    function userExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    
    // Helper function to check if user is admin (checks voters collection first, then users)
    function isAdmin() {
      return isAuthenticated() && (
        // Check voters collection first (our current structure)
        (exists(/databases/$(database)/documents/voters/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/voters/$(request.auth.uid)).data.role == 'admin') ||
        // Also check users collection (alternative structure)
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }
    
    // System collection (for admin initialization flag)
    match /system/{document} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated(); // Allow authenticated users to write during initialization
    }
    
    // Users collection (main user/voter records)
    match /users/{userId} {
      // Users can create their own record during registration
      allow create: if isAuthenticated() && request.auth.uid == userId;
      
      // Users can read their own data, admins can read all
      allow read: if isAuthenticated() && 
                     (request.auth.uid == userId || isAdmin());
      
      // Users can update their own data, admins can update any
      allow update: if isAuthenticated() && 
                       (request.auth.uid == userId || isAdmin());
      
      // Only admins can delete user records
      allow delete: if isAdmin();
    }
    
    // Voters collection (primary - our current structure)
    match /voters/{voterId} {
      // Users can create their own voter record during registration
      allow create: if isAuthenticated() && request.auth.uid == voterId;
      
      // Users can read their own data, admins can read all
      allow read: if isAuthenticated() && 
                     (request.auth.uid == voterId || isAdmin());
      
      // Users can update their own data, admins can update any
      allow update: if isAuthenticated() && 
                       (request.auth.uid == voterId || isAdmin());
      
      // Only admins can delete voter records
      allow delete: if isAdmin();
    }
    
    // Schools/Institutions collection
    match /schools/{schoolId} {
      // Anyone can read school information
      allow read: if true;
      
      // Only admins can create, update, or delete schools
      allow create, update, delete: if isAdmin();
    }
    
    // Institutions collection (alternative name, same as schools)
    match /institutions/{institutionId} {
      // Anyone can read institution information
      allow read: if true;
      
      // Only admins can create, update, or delete institutions
      allow create, update, delete: if isAdmin();
    }
    
    // Candidates collection
    match /candidates/{candidateId} {
      // Anyone can read candidate information
      allow read: if true;
      
      // Only authenticated admins can create, update, or delete candidates
      allow create, update, delete: if isAdmin();
      
      // Votes subcollection for each candidate (if you want to track individual votes)
      match /votes/{userId} {
        // A user can create a vote only if authenticated and the vote document ID matches their UID
        // This ensures one vote per user per candidate
        allow create: if isAuthenticated() && request.auth.uid == userId;
        
        // Votes are generally immutable; disallow updates or deletions
        allow update, delete: if false;
        
        // Allows anyone to read individual votes (consider privacy implications)
        allow read: if true;
      }
    }
    
    // Elections collection
    match /elections/{electionId} {
      // Anyone can read election information
      allow read: if true;
      
      // Only admins can create, update, or delete elections
      allow create, update, delete: if isAdmin();
    }
    
    // Admins collection (if you want a separate collection)
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    
    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

